PORT=5000
MONGO_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/?retryWrites=true&w=majority

JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

MONGO_DB=autorepuestos
# Solo en producción, detrás de un proxy como Render:
# TRUST_PROXY=1

# Solo en producción:
# NODE_ENV=production
# ADMIN_NOMBRE=Administrador
# ADMIN_CORREO=correo-del-administrador@ejemplo.com
# ADMIN_CLAVE=una-clave-segura-de-8-o-mas-caracteres
# SEED_FORZAR=si          (solo al cargar los datos iniciales por primera vez)
# DOCS_PUBLICAS=false     (oculta /api-docs)